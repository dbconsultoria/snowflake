# Copie para snowflake/.env (ou .env na raiz) e preencha. Nunca faça commit do .env.

# ---- Snowflake ----
SNOWFLAKE_ACCOUNT=<org>-<account>
SNOWFLAKE_USER=ETL_USER
SNOWFLAKE_WAREHOUSE=ETL_WH
SNOWFLAKE_ROLE=ETL_ROLE
SNOWFLAKE_DATABASE=MYSPARK_DL
# Local: caminho do .p8, relativo à raiz do projeto
SNOWFLAKE_PRIVATE_KEY_PATH=./snowflake/rsa_key.p8
# GitHub Actions: conteúdo PEM completo do .p8 (tem prioridade sobre o PATH)
SNOWFLAKE_PRIVATE_KEY=
# Só se a chave for criptografada
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=

# ---- TiDB Cloud (fonte OLTP, TLS obrigatório) ----
DB_HOST=<gateway>.tidbcloud.com
DB_PORT=4000
DB_USERNAME=
DB_PASSWORD=
DB_DATABASE=mydb
# Opcional: CA específica; padrão = bundle do certifi
DB_SSL_CA=

# ---- Opcional ----
LOG_LEVEL=INFO
